target_presets = PackedStringArray("BasicCave")
start_minutes = 600
difficulty = 0.0

[sub_resource type="Resource" id="Stage2"]
script = ExtResource("2_stage")
lesson = "2. Raise the bed: find deeper snow and build a raised cave. Keep the sleeping platform above the entrance passage; the weather is as gentle as in stage 1."
introduced_presets = PackedStringArray("BasicCave", "RaisedCave")
target_presets = PackedStringArray("RaisedCave")
start_minutes = 600
difficulty = 0.0

[sub_resource type="Resource" id="Stage3"]
script = ExtResource("2_stage")
lesson = "3. Prepare for the night: choose your cave, dry your clothes and check the vent and bedding. Wake and get up when needed. Survive to open chapter 2."
introduced_presets = PackedStringArray("BasicCave", "RaisedCave")
target_presets = PackedStringArray("RaisedCave", "BasicCave")
start_minutes = 780
difficulty = 0.35

