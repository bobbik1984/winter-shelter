class_name Loc
extends RefCounted

## 双语（English / 中文）：按英文源字符串查表，中文模式下返回译文；查不到原样返回。
## 用法：Loc.t("Need %d dry wood.") % n —— 先查表再格式化，所以 % 占位符必须与英文一致。
## 语言保存在 user://settings.cfg [ui] lang；运行时按 [L] 切换（GameDirector）。
## 夜间报告的 6 条归因在中文模式下直接使用 NightSimulator 自带的中文 notes。

const PATH := "user://settings.cfg"
static var lang: String = ""

static func is_zh() -> bool:
	if lang == "":
		var cfg := ConfigFile.new()
		lang = String(cfg.get_value("ui", "lang", "en")) if cfg.load(PATH) == OK else "en"
	return lang == "zh"

const CJK_FONT := "res://assets/fonts/DroidSansFallbackFull.ttf"
static var _font_ready := false

## 给默认字体挂一个随包附带的 CJK 后备字体（Apache-2.0），没装中文字体的机器也能显示中文。
## 拉丁字符仍用默认字体；只有缺字时才落到后备字体。
static func ensure_cjk_font() -> void:
	if _font_ready:
		return
	_font_ready = true
	var base := ThemeDB.fallback_font
	var cjk := load(CJK_FONT) as Font
	if base == null or cjk == null:
		return
	var fb := base.fallbacks
	fb.append(cjk)
	base.fallbacks = fb

static func set_lang(l: String) -> void:
	lang = l
	var cfg := ConfigFile.new()
	cfg.load(PATH)
	cfg.set_value("ui", "lang", l)
	cfg.save(PATH)

static func t(s: String) -> String:
	if not is_zh():
		return s
	return ZH.get(s, s)

